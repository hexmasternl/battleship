<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Container image for the Azure deployment: dotnet publish -t:PublishContainer. The workflow
         sets ContainerRegistry and ContainerImageTag; the repository name is fixed here. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>battleship/games-api</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\HexMaster.Battleship.Aspire\HexMaster.Battleship.Aspire.ServiceDefaults\HexMaster.Battleship.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\HexMaster.Battleship.Games\HexMaster.Battleship.Games.csproj" />
    <ProjectReference Include="..\HexMaster.Battleship.Games.Data\HexMaster.Battleship.Games.Data.csproj" />
  </ItemGroup>

</Project>
