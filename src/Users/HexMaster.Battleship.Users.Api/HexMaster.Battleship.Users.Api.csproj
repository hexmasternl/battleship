<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bd45b2c6-8a98-4730-b835-b6fa9979b008</UserSecretsId>
    <!-- Container image for the Azure deployment: dotnet publish -t:PublishContainer. The workflow
         sets ContainerRegistry and ContainerImageTag; the repository name is fixed here. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>battleship/users-api</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\HexMaster.Battleship.Aspire\HexMaster.Battleship.Aspire.ServiceDefaults\HexMaster.Battleship.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\HexMaster.Battleship.Users\HexMaster.Battleship.Users.csproj" />
    <ProjectReference Include="..\HexMaster.Battleship.Users.Data.TableStorage\HexMaster.Battleship.Users.Data.TableStorage.csproj" />
  </ItemGroup>

</Project>
